# Caddy Load Balancer Configuration
# This Caddy instance serves as the front of a zero-downtime deployment: it
# sits between the cloudflared tunnel and the app replicas, so a rolling
# recreate of app-1/app-2 never returns an error to a visitor.

{
	admin off
	auto_https off

	# The tunnel (cloudflared) reaches this LB from a private address and puts the
	# visitor address in CF-Connecting-IP. Trusting only the private ranges lets
	# {http.request.client_ip} be the real visitor when that header is there and
	# the peer address otherwise, so the per-IP rate limits are not a single
	# global bucket. Never forward a client-supplied CF-Connecting-IP blindly.
	servers {
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# Load balance between the app replicas
:80 {
	log {
		level WARN
	}

	# Health check endpoint for the LB itself (the compose healthcheck probes
	# this, not an app replica, so a half-deployed stack is never reported
	# healthy).
	@health path /health
	handle @health {
		respond "OK" 200
	}

	# Reverse proxy to the app replicas with load balancing
	reverse_proxy app-1:8000 app-2:8000 {
		# Use least connection policy
		lb_policy least_conn

		# Transparent failover: if the chosen upstream is unreachable (e.g.
		# mid-swap during a deploy, while a replica is restarting), retry on the
		# healthy upstream instead of returning 502/500. This is what makes the
		# deploy swap window invisible to clients.
		lb_try_duration 5s
		lb_try_interval 250ms

		# Active health checks against the app's own /up route (routes/web.php).
		# It is deliberately cheap: it does not boot Laravel or touch the DB.
		health_uri /up
		health_interval 2s
		health_timeout 3s
		health_status 2xx

		# Mark unhealthy after 1 failed check (instant failover)
		fail_duration 10s
		max_fails 1
		unhealthy_status 5xx
		unhealthy_latency 5s

		# Preserve original headers for backend logging. The scheme is taken from
		# the tunnel (cloudflared sets X-Forwarded-Proto: https); do not overwrite
		# it with the LB's own http scheme, or Laravel/Twig would generate http
		# URLs for requests it sees.
		header_up X-Forwarded-Host {http.request.host}
		header_up X-Forwarded-Port {http.request.port}
		header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
		header_up X-Forwarded-For {http.request.client_ip}
	}
}
